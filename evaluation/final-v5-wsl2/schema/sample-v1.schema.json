{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskgate-final-v5-sample-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "deployment_id", "experiment_id", "cell_id", "sample_id", "iteration", "order_position", "random_seed", "pair_id", "paired_system_order", "root_group_id", "system", "mode", "workload_id", "scale", "client_available_ms", "client_full_drain_ms", "pipeline_ms", "diagnostic_ms", "row_count", "column_count", "result_sha256", "artifact_sha256", "object_sha256", "actual_release_facts", "charged_release_facts", "actual_dependency_facts", "charged_dependency_facts", "actual_outcome_facts", "charged_outcome_facts", "predicate_atom_count", "composite_count", "semantic_replay", "idempotent_replay", "business_sql_delta", "root_epoch_before", "root_epoch_after", "root_set_sha256_before", "root_set_sha256_after", "parquet_bytes", "encrypted_object_bytes", "receipt_version", "receipt_sha256", "artifact_intent_sha256", "availability_audit_sha256", "gateway_memory_peak_bytes", "gateway_cpu_usec_delta", "gateway_network_rx_delta", "gateway_network_tx_delta", "control_wal_bytes_delta", "business_wal_bytes_delta", "status", "error_code", "publication_eligible"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "pattern": "^deployment-[0-9]{2}$"},
    "experiment_id": {"enum": ["baseline", "scale", "artifact", "rls", "attack", "provsql", "compiler", "concurrency", "rq5"]},
    "cell_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "process_replicate": {"type": "integer", "minimum": 1},
    "order_position": {"type": "integer", "minimum": 1},
    "random_seed": {"type": "integer"},
    "pair_id": {"type": "string", "minLength": 1},
    "paired_system_order": {"type": "string", "minLength": 1},
    "root_group_id": {"type": "string", "minLength": 1},
    "system": {"enum": ["postgresql", "taskgate", "provsql"]},
    "mode": {"type": "string", "minLength": 1},
    "workload_id": {"type": "string", "minLength": 1},
    "scale": {"type": "string", "minLength": 1},
    "client_available_ms": {"type": "number", "minimum": 0},
    "client_full_drain_ms": {"type": "number", "minimum": 0},
    "generation_boundary_ms": {"type": "number", "minimum": 0},
    "full_taskgate_ms": {"type": "number", "minimum": 0},
    "pipeline_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}, "required": ["prepare", "execute_and_derive", "artifact_stage", "control_settlement", "artifact_publication", "response_finalize", "server_total"]},
    "diagnostic_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "row_count": {"type": "integer", "minimum": 0},
    "column_count": {"type": "integer", "minimum": 0},
    "result_sha256": {"type": "string"},
    "physical_sql_sha256": {"type": "string"},
    "logical_sql_sha256": {"type": "string"},
    "query_plan_sha256": {"type": "string"},
    "release_set_sha256": {"type": "string"},
    "dependency_set_sha256": {"type": "string"},
    "outcome_set_sha256": {"type": "string"},
    "artifact_sha256": {"type": "string"},
    "object_sha256": {"type": "string"},
    "actual_release_facts": {"type": "integer", "minimum": 0},
    "charged_release_facts": {"type": "integer", "minimum": 0},
    "actual_dependency_facts": {"type": "integer", "minimum": 0},
    "charged_dependency_facts": {"type": "integer", "minimum": 0},
    "actual_outcome_facts": {"type": "integer", "minimum": 0},
    "charged_outcome_facts": {"type": "integer", "minimum": 0},
    "predicate_atom_count": {"type": "integer", "minimum": 0},
    "composite_count": {"type": "integer", "minimum": 0},
    "semantic_replay": {"type": "boolean"},
    "idempotent_replay": {"type": "boolean"},
    "business_sql_delta": {"type": "integer", "minimum": 0},
    "root_epoch_before": {"type": "integer", "minimum": 0},
    "root_epoch_after": {"type": "integer", "minimum": 0},
    "root_task_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_set_sha256_before": {"type": "string"},
    "root_set_sha256_after": {"type": "string"},
    "parquet_bytes": {"type": "integer", "minimum": 0},
    "encrypted_object_bytes": {"type": "integer", "minimum": 0},
    "receipt_version": {"type": "string"},
    "receipt_sha256": {"type": "string"},
    "artifact_intent_sha256": {"type": "string"},
    "availability_audit_sha256": {"type": "string"},
    "receipt_verified": {"type": "boolean"},
    "artifact_available": {"type": "boolean"},
    "rejected": {"type": "boolean"},
    "rejected_no_result": {"type": "boolean"},
    "rejected_no_artifact": {"type": "boolean"},
    "rejected_no_successful_audit": {"type": "boolean"},
    "cross_epoch_replay": {"type": "boolean"},
    "budget_violation": {"type": "boolean"},
    "gateway_memory_peak_bytes": {"type": "integer", "minimum": 0},
    "gateway_cpu_usec_delta": {"type": "integer", "minimum": 0},
    "gateway_network_rx_delta": {"type": "integer", "minimum": 0},
    "gateway_network_tx_delta": {"type": "integer", "minimum": 0},
    "control_wal_bytes_delta": {"type": "integer", "minimum": 0},
    "business_wal_bytes_delta": {"type": "integer", "minimum": 0},
    "status": {"enum": ["pass", "fail", "invalid"]},
    "error_code": {"type": "string"},
    "publication_eligible": {"type": "boolean"},
    "kernel_only": {"type": "boolean"},
    "reason": {"type": "string"},
    "baseline_verification": {"type": "object"},
    "recovery_verification": {"type": "object"},
    "rls_verification": {"type": "object"},
    "attack_verification": {"type": "object"},
    "provsql_verification": {"type": "object"},
    "compiler_verification": {"type": "object"},
    "concurrency_verification": {"type": "object"},
    "rq5_verification": {"type": "object"}
    ,"trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "concrete_sql", "prior_state_sha256", "result_sha256", "next_sql_sha256"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "concrete_sql": {"type": "string", "minLength": 1},
          "prior_state_sha256": {"type": "string"},
          "result_sha256": {"type": "string"},
          "next_sql_sha256": {"type": "string"},
          "plan_sha256": {"type": "string"},
          "observation_sha256": {"type": "string"},
          "release_set_sha256": {"type": "string"},
          "dependency_set_sha256": {"type": "string"},
          "outcome_set_sha256": {"type": "string"},
          "rejected": {"type": "boolean"},
          "no_result": {"type": "boolean"},
          "no_available_artifact": {"type": "boolean"},
          "no_successful_audit": {"type": "boolean"}
        }
      }
    }
  }
}
