      "plan": {
        "from": {
          "join": {
            "left": {
              "product": "scale_orders",
              "role": "scale_orders"
            },
            "right": {
              "product": "scale_lineitem",
              "role": "scale_lineitem"
            },
            "on": [
              {
                "left": "scale_orders.o_orderkey",
                "right": "scale_lineitem.l_orderkey"
              }
