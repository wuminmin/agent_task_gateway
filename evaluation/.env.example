# Copy this file to evaluation/.env. Paths are container paths and must remain
# under /workspace so the runner can checksum every publication input.

EVAL_ENVIRONMENT_MANIFEST=/workspace/evaluation/environment/environment.local.json

# Optional for custom configs with "cache_strategy": "cold". The checked
# configs are warm-cache configs and do not read these variables.
# EVAL_TPCH_SF1_DIRECT_CACHE_RESET_COMMAND=["/workspace/evaluation/environment/cache-reset.local","--experiment","tpch_sf1","--baseline","direct_postgresql"]

# TPC-H SF1
EVAL_TPCH_SF1_DIRECT_DSN=postgres://direct_reader:change-me@host.docker.internal:5432/tpch_sf1?sslmode=disable
EVAL_TPCH_SF1_NATIVE_DSN=postgres://native_reader:change-me@host.docker.internal:5432/tpch_sf1?sslmode=disable
EVAL_TPCH_SF1_AST_URL=http://host.docker.internal:8088/query
EVAL_TPCH_SF1_AST_TOKEN=change-me
EVAL_TPCH_SF1_TASKGATE_URL=http://host.docker.internal:8082/mcp
EVAL_TPCH_SF1_TASKGATE_TOKEN=change-me
EVAL_TPCH_SF1_TASKS_FILE=/workspace/evaluation/config/tasks.local.json
EVAL_TPCH_SF1_DATASET_MANIFEST=/workspace/evaluation/environment/tpch-sf1.sha256-manifest.local
EVAL_TPCH_SF1_DATASET_SHA256=replace-with-exact-64-lowercase-hex
EVAL_TPCH_SF1_DIRECT_METRICS_COMMAND=["/workspace/evaluation/environment/metrics-probe.local","--experiment","tpch_sf1","--baseline","direct_postgresql"]
EVAL_TPCH_SF1_NATIVE_METRICS_COMMAND=["/workspace/evaluation/environment/metrics-probe.local","--experiment","tpch_sf1","--baseline","native_view"]
EVAL_TPCH_SF1_AST_METRICS_COMMAND=["/workspace/evaluation/environment/metrics-probe.local","--experiment","tpch_sf1","--baseline","ast_only_gateway"]
EVAL_TPCH_SF1_TASKGATE_METRICS_COMMAND=["/workspace/evaluation/environment/metrics-probe.local","--experiment","tpch_sf1","--baseline","full_taskgate"]

# TPC-DS SF1
