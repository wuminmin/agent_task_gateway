# Generate with: openssl rand -base64 32
GATEWAY_DATA_KEY=
# Stable identifier for the data key above; changing it starts a new result key series.
GATEWAY_DATA_KEY_ID=local-aes256-gcm-v1

# Dedicated Gateway Ed25519 query-receipt seed (32 bytes, base64) and key ID.
# Generate the seed with: openssl rand -base64 32
GATEWAY_RECEIPT_KEY_ID=gateway-ed25519-v1
GATEWAY_RECEIPT_PRIVATE_KEY=
# Optional public query-receipt verifier keyring JSON for historical keys and
# active-key validity windows. Gateway also publishes its active public key.
# [{"key_id":"gateway-ed25519-v1","public_key":"base64","valid_from":"2026-07-01T00:00:00Z","retired_at":"2026-10-01T00:00:00Z"}]
GATEWAY_RECEIPT_KEYRING_JSON=

# Demo identities. Replace these values outside local development.
TASKBOUND_ALICE_TOKEN=
TASKBOUND_CAROL_TOKEN=
GATEWAY_ADMIN_TOKEN=
# Connector row ceiling applies independently to the visible and streamed
# provenance statements. 1,200,000 is required to admit the V4 maximum-point
# fixture (345,000 provenance rows / 1,035,000 base facts) without truncation.
GATEWAY_CONNECTOR_MAX_ROWS=1200000
GATEWAY_CONNECTOR_MAX_CONNECTIONS=4
GATEWAY_CONTROL_MAX_OPEN_CONNECTIONS=10
GATEWAY_CONTROL_MAX_IDLE_CONNECTIONS=4
GATEWAY_CONTROL_CONNECTION_MAX_LIFETIME=30m
# Final-V5 concurrency only. Generate independently with openssl rand -base64
# 32 and export the same value to the source-controlled adapter process. A
# formal width-500 run must explicitly raise and bind the Control/connector
# capacities above; ordinary deployments retain their historical defaults.
TASKGATE_FINAL_V5_CONCURRENCY_TOKEN=
GATEWAY_EVALUATION_CONCURRENCY_HTTP_ACTIVE=512
GATEWAY_EVALUATION_CONCURRENCY_HTTP_QUEUE=512
GATEWAY_RESULT_RETENTION_TTL=
GATEWAY_RESULT_RETENTION_SWEEP_INTERVAL=1h

# TaskGate-managed S3-compatible result artifact storage. MinIO root
# credentials are used only by the server and one-shot bucket initializer;
# Gateway receives the separate bucket-scoped application credentials.
MINIO_ROOT_USER=taskgate-minio-admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
GATEWAY_OBJECT_STORE_ENDPOINT=http://result-object-store:9000
GATEWAY_OBJECT_STORE_REGION=us-east-1
GATEWAY_OBJECT_STORE_BUCKET=taskgate-results
GATEWAY_OBJECT_STORE_ACCESS_KEY=taskgate-gateway
GATEWAY_OBJECT_STORE_SECRET_KEY=
GATEWAY_OBJECT_STORE_PATH_STYLE=true
# Public Gateway origin used in short-lived deliver_result capability URLs.
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8082
# Generate independently with: openssl rand -base64 32
# Empty falls back to OA_CALLBACK_SECRET for the local demo only.
GATEWAY_DELIVERY_SIGNING_KEY=
GATEWAY_RESULT_DELIVERY_TTL=5m
GATEWAY_RESULT_DOWNLOAD_TIMEOUT=30m
GATEWAY_RESULT_DOWNLOAD_CONCURRENCY=4
GATEWAY_RESULT_PROMOTION_TIMEOUT=30m
# Only unreferenced private staging uploads older than this grace period are collected.
GATEWAY_RESULT_STAGING_ORPHAN_TTL=24h
# Private encrypted scratch files live here only while being uploaded.
GATEWAY_RESULT_TEMP_DIR=/tmp/taskgate-result-artifacts
GATEWAY_RESULT_PREVIEW_MAX_BYTES=67108864

GATEWAY_AUDIT_ANCHOR_URL=
GATEWAY_AUDIT_ANCHOR_INTERVAL=5m
GATEWAY_AUDIT_ANCHOR_KEY_ID=audit-anchor-ed25519-v1
GATEWAY_AUDIT_ANCHOR_PRIVATE_KEY=
# Compose compiles both immutable V4 snapshot publications into a named volume
# before Gateway starts. Direct binary launches must set GATEWAY_SNAPSHOT_ARTIFACT_DIR
# to the directory produced by cmd/snapshot-index.
OA_SERVICE_TOKEN=
OA_CALLBACK_SECRET=
# Dedicated OA Ed25519 approval-receipt keypair. Gateway receives only the
# 32-byte raw public key; OA receives the 32-byte seed, both base64 encoded.
OA_RECEIPT_KEY_ID=oa-ed25519-v1
OA_RECEIPT_PRIVATE_KEY=
OA_RECEIPT_PUBLIC_KEY=
# Optional Gateway verifier keyring JSON:
# [{"key_id":"oa-ed25519-v1","public_key":"base64","valid_from":"2026-07-01T00:00:00Z","retired_at":"2026-10-01T00:00:00Z"}]
OA_RECEIPT_KEYRING_JSON=
OA_SESSION_SECRET=
OA_ALICE_PASSWORD=
OA_BOB_PASSWORD=

# Gateway control PostgreSQL. Navicat: 127.0.0.1:25433.
# postgres uses CONTROL_POSTGRES_ADMIN_PASSWORD; gateway_control uses CONTROL_DB_PASSWORD.
CONTROL_POSTGRES_PORT=25433
CONTROL_POSTGRES_DB=taskbound_gateway
CONTROL_POSTGRES_ADMIN_PASSWORD=
CONTROL_DB_PASSWORD=

# Business PostgreSQL is internal by default. The 127.0.0.1:25434 Navicat
# endpoint exists only with the explicitly non-paper compose.debug.yaml override.
# POSTGRES_USER uses POSTGRES_PASSWORD; gateway_reader uses GATEWAY_DB_PASSWORD.
# Direct `cmd/snapshot-index` runs whose input declares `source_relation` must
# additionally export SNAPSHOT_POSTGRES_DSN for this same read-only role.
POSTGRES_PORT=25434
POSTGRES_DB=travel_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
GATEWAY_DB_PASSWORD=

DEEPSEEK_API_KEY=
