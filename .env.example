# Generate with: openssl rand -base64 32
GATEWAY_DATA_KEY=

# Dedicated Gateway Ed25519 query-receipt seed (32 bytes, base64) and key ID.
# Generate the seed with: openssl rand -base64 32
GATEWAY_RECEIPT_KEY_ID=gateway-ed25519-v1
GATEWAY_RECEIPT_PRIVATE_KEY=

# Demo identities. Replace these values outside local development.
TASKBOUND_ALICE_TOKEN=
TASKBOUND_CAROL_TOKEN=
OA_SERVICE_TOKEN=
OA_CALLBACK_SECRET=
# Dedicated OA Ed25519 approval-receipt keypair. Gateway receives only the
# 32-byte raw public key; OA receives the 32-byte seed, both base64 encoded.
OA_RECEIPT_KEY_ID=oa-ed25519-v1
OA_RECEIPT_PRIVATE_KEY=
OA_RECEIPT_PUBLIC_KEY=
OA_SESSION_SECRET=
OA_ALICE_PASSWORD=
OA_BOB_PASSWORD=

# Gateway control PostgreSQL. Navicat: 127.0.0.1:25433.
# postgres uses CONTROL_POSTGRES_ADMIN_PASSWORD; gateway_control uses CONTROL_DB_PASSWORD.
CONTROL_POSTGRES_PORT=25433
CONTROL_POSTGRES_DB=taskbound_gateway
CONTROL_POSTGRES_ADMIN_PASSWORD=
CONTROL_DB_PASSWORD=

# Business PostgreSQL is internal by default. The 127.0.0.1:25434 Navicat
# endpoint exists only with the explicitly non-paper compose.debug.yaml override.
# POSTGRES_USER uses POSTGRES_PASSWORD; gateway_reader uses GATEWAY_DB_PASSWORD.
POSTGRES_PORT=25434
POSTGRES_DB=travel_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
GATEWAY_DB_PASSWORD=
